# NAO Sensei — machine-specific settings for start_nao_sensei.ps1
# ---------------------------------------------------------------------------
# Copy this file to ".env" (which is git-ignored) and fill in your own values.
# These are ONLY used by the one-click startup script; the manual run commands
# in the README do not need this file.
#
#   copy .env.example .env      (Windows)
#
# None of these are secrets — they just describe where things live on YOUR
# machine, so they are kept out of version control.

# Full path to the Python interpreter of your project environment
# (the conda env or venv where you installed requirements.txt).
NAO_SENSEI_PYTHON=C:\path\to\envs\nao-sensei\python.exe

# The robot's reachable address. Over a direct Ethernet cable this is a
# link-local (169.254.x.x) address that can change if the cable is replugged
# — re-verify with `ping` if the startup script fails at the bridge step.
# Leave as-is if you are not using a physical robot.
NAO_IP=169.254.242.9

# Path to the private SSH key authorized on the robot (id_rsa, not ed25519 —
# NAO's OpenSSH is too old for ed25519; see the README).
NAO_SSH_KEY=%USERPROFILE%\.ssh\id_rsa_nao
